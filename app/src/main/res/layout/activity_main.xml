<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1419"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU / GPU Stress Test"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="TEST TARGET"
                android:textColor="#8FA3B5"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCpu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#40C4FF"
                    android:text="CPU"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbGpu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#40C4FF"
                    android:text="GPU"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbBoth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:buttonTint="#40C4FF"
                    android:checked="true"
                    android:text="CPU + GPU"
                    android:textColor="#FFFFFF" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="INTENSITY"
                android:textColor="#8FA3B5"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgIntensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbLow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#FFB74D"
                    android:text="Low"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:buttonTint="#FFB74D"
                    android:checked="true"
                    android:text="Medium"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbHigh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#FFB74D"
                    android:text="High"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbExtreme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:buttonTint="#FF5252"
                    android:text="Extreme"
                    android:textColor="#FFFFFF" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/cbSafety"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#69F0AE"
                android:checked="true"
                android:text="Safety stop (battery 45.0 °C or CPU/GPU 95.0 °C)"
                android:textColor="#C5D1DB"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbRoot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#69F0AE"
                android:text="Use root to read CPU/GPU sensors (rooted phones only)"
                android:textColor="#C5D1DB"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="START STRESS TEST"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="00:00:00"
                android:textColor="#FFFFFF"
                android:textSize="34sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="running time"
                android:textColor="#8FA3B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvThrottle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Not running"
                android:textColor="#8FA3B5"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="#1B232C"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CPU"
                        android:textColor="#8FA3B5"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCpuTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#FF5252"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="#1B232C"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPU"
                        android:textColor="#8FA3B5"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvGpuTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#40C4FF"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="1"
                    android:background="#1B232C"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BATTERY"
                        android:textColor="#8FA3B5"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvBatTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#69F0AE"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="TEMPERATURE - LAST 2 MINUTES"
                android:textColor="#8FA3B5"
                android:textSize="12sp" />

            <com.example.stresstest.ChartView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="● CPU"
                    android:textColor="#FF5252"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="● GPU"
                    android:textColor="#40C4FF"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="● Battery"
                    android:textColor="#69F0AE"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#1B232C"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:textColor="#E6EDF3"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:textColor="#C5D1DB"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSensors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#6B7F91"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A0E12"
        android:paddingLeft="16dp"
        android:paddingTop="2dp"
        android:text="GPU load surface (must stay visible while GPU test runs)"
        android:textColor="#6B7F91"
        android:textSize="10sp" />

    <android.opengl.GLSurfaceView
        android:id="@+id/glView"
        android:layout_width="match_parent"
        android:layout_height="100dp" />
</LinearLayout>
